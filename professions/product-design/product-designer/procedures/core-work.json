{"schema_version":"0.1","profession_id":"product-designer","procedures":[{"id":"design-product-flow","steps":["Read product/user evidence.","Model task flow/material states.","Generate alternatives for uncertain interactions.","Choose candidate with evidence/assumption rationale.","Build prototype/spec.","Hand to Research/Accessibility/Frontend.","Revise from findings."],"stop_conditions":["User need invented","Product outcome unresolved"]},{"id":"design-change-review","steps":["State new evidence/constraint.","Compare old/new consequences.","Preserve learned contracts.","Prototype necessary change.","Define validation/handoff and supersede rationale visibly."],"stop_conditions":["Preference-only change with unresolved problem"]}]}
