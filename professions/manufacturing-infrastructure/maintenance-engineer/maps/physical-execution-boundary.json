{"schema_version":"0.1","id":"maintenance-physical-execution-boundary","evidence_state":"NOT_TESTED","purpose":"Classify physical maintenance execution surfaces without turning broad occupational evidence into executable repair instructions.","execution_classes":[{"class":"direct-observation","examples":["visual inspection","condition observation"],"required_gates":["asset identity","access authorization","safe work state","observer competence"]},{"class":"instrumented-measurement","examples":["electrical/precision/condition measurement"],"required_gates":["instrument fitness/calibration","measurement method","safe connection/access","competent executor"]},{"class":"manual-or-powered-tool-work","examples":["hand/power tool intervention"],"required_gates":["approved work procedure","isolation/permit where applicable","tool suitability","competent executor"]},{"class":"installation-alignment-balancing","examples":["setup","alignment","balancing","component installation"],"required_gates":["OEM/site specification","measurement criteria","competent executor","post-work verification"]}],"machine_rule":"A model/deterministic flow may classify, plan prerequisites and verify records. It may not claim a physical action or observation occurred unless an authorized physical executor/sensor/tool produces evidence.","stop_conditions":["asset/configuration uncertain","safe-state/permit unresolved","required competent/licensed role absent","tool/instrument fitness unknown","site/OEM procedure unavailable or conflicting"]}