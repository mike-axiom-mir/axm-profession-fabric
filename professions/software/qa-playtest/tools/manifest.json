{
  "schema_version": "0.1",
  "tool_contracts": [
    {"id":"source-reader","usable_by":["human-guided","ai-model","machine-intelligence","deterministic-flow"],"inputs":["source/version identifiers"],"outputs":["exact content/state"],"deterministic_when":"Identifiers resolve unambiguously.","judgment_boundary":"Choosing which source is authoritative may require professional/context judgment."},
    {"id":"diff-inspector","usable_by":["human-guided","ai-model","machine-intelligence","deterministic-flow"],"inputs":["baseline","candidate"],"outputs":["structural diff","candidate changed surfaces"],"deterministic_when":"Computing literal differences.","judgment_boundary":"Semantic overlap and player/user consequence require interpretation."},
    {"id":"test-runner","usable_by":["human-guided","ai-model","machine-intelligence","deterministic-flow"],"inputs":["fixture","candidate","environment"],"outputs":["exit/result/logs"],"deterministic_when":"Fixture and environment are deterministic.","judgment_boundary":"A failing fixture is not automatically a product defect."},
    {"id":"interactive-executor","usable_by":["human-guided","ai-model","machine-intelligence","deterministic-flow"],"inputs":["candidate","input sequence","execution surface"],"outputs":["observable state transitions","artifacts"],"deterministic_when":"Inputs/runtime are automatable and stable.","judgment_boundary":"Human feel, natural discovery, and physical-device behavior cannot be inferred from simulation alone."},
    {"id":"artifact-observer","usable_by":["human-guided","ai-model","machine-intelligence"],"inputs":["rendered artifact"],"outputs":["visual observations"],"deterministic_when":"Never assumed; pixel checks can be deterministic for narrow properties but broader visual inspection is an observation surface.","judgment_boundary":"Subjective quality/accessibility claims require appropriate observers and specialist boundaries."},
    {"id":"measurement-recorder","usable_by":["human-guided","ai-model","machine-intelligence","deterministic-flow"],"inputs":["value stream","method","units"],"outputs":["measurement record"],"deterministic_when":"Method and sample are explicit.","judgment_boundary":"Meaning, thresholds, and generalization may require professional judgment."},
    {"id":"state-fixture-builder","usable_by":["human-guided","ai-model","machine-intelligence","deterministic-flow"],"inputs":["baseline state","transition/replay description"],"outputs":["controlled fixture","fixture provenance"],"deterministic_when":"Replay/edits are explicit.","judgment_boundary":"Whether the fixture represents a meaningful real state requires evidence and judgment."}
  ]
}
