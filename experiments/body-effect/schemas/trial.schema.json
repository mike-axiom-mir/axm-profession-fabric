{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://axm.local/experiments/body-effect/trial.schema.json","title":"AXM Professional Body Effect Trial","type":"object","additionalProperties":false,"required":["schema_version","trial_id","experiment_id","fixture_id","profession_id","arm_code","treatment","executor","task_identity","treatment_identity","contamination","output_identity","evaluation","status","result_claim"],"properties":{"schema_version":{"const":"0.1"},"trial_id":{"type":"string","minLength":1},"experiment_id":{"type":"string","minLength":1},"fixture_id":{"type":"string","minLength":1},"profession_id":{"type":"string","minLength":1},"arm_code":{"enum":["A","B"]},"treatment":{"enum":["role-only","professional-body"]},"executor":{"type":"object","required":["family","version_or_snapshot","configuration","fresh_context"],"properties":{"family":{"type":"string","minLength":1},"version_or_snapshot":{"type":"string","minLength":1},"configuration":{"type":"string","minLength":1},"fresh_context":{"type":"boolean"}}},"task_identity":{"type":"object","required":["path","git_blob_sha"],"properties":{"path":{"type":"string","minLength":1},"git_blob_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"}}},"treatment_identity":{"type":"object","required":["role_instruction","professional_body_path","professional_body_git_blob_sha"],"properties":{"role_instruction":{"type":"string","minLength":1},"professional_body_path":{"type":["string","null"]},"professional_body_git_blob_sha":{"type":["string","null"]}}},"contamination":{"type":"object","required":["clean_control_eligible","reason"],"properties":{"clean_control_eligible":{"type":"boolean"},"reason":{"type":"string"}}},"output_identity":{"type":"object","required":["artifact_paths","artifact_sha256"],"properties":{"artifact_paths":{"type":"array","items":{"type":"string"}},"artifact_sha256":{"type":"array","items":{"type":"string"}}}},"evaluation":{"type":"object","required":["blinded","evaluator_id