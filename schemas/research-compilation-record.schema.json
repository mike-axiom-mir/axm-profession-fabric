{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://axm.local/schemas/research-compilation-record.schema.json","title":"AXM Research Compilation Record","type":"object","additionalProperties":false,"required":["schema_version","profession_id","compiled_on","research_packet","research_packet_blob_sha","audited_body_blob_sha","body_rewrite","maturity_effect","authority_boundary_preserved","dispositions","adopted_files","nonclaims"],"properties":{"schema_version":{"const":"0.1"},"profession_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"compiled_on":{"type":"string","minLength":1},"research_packet":{"type":"string","minLength":1},"research_packet_blob_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"audited_body_blob_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"body_rewrite":{"const":false},"maturity_effect":{"const":"NO_CHANGE"},"authority_boundary_preserved":{"const":true},"dispositions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/disposition"}},"adopted_files":{"$ref":"#/$defs/string_list"},"nonclaims":{"$ref":"#/$defs/string_list"}},"$defs":{"string_list":{"type":"array","items":{"type":"string","minLength":1}},"disposition":{"type":"object","additionalProperties":false,"required":["gap_id","decision","target_files","rationale","residual_gap"],"properties":{"gap_id":{"type":"string","minLength":1},"decision":{"enum":["ADOPTED","PARTIAL","HOLD","REJECTED"]},"target_files":{"$ref":"#/$defs/string_list"},"rationale":{"type":"string","minLength":1},"residual_gap":{"type":"string"}}}}}